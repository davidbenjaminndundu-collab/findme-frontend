# Cible du proxy Vite en développement (/api et /sanctum) : conteneur Laravel, ou http://localhost:8000 hors Docker.
VITE_API_TARGET=http://backend:8000

# Base des endpoints métier. Relative en développement (même origine grâce au proxy, cookies Sanctum fiables).
# Production : https://api.findme.cd/api/v1
VITE_API_BASE_URL=/api/v1

# Racine du serveur pour GET /sanctum/csrf-cookie. Vide en développement ; production : https://api.findme.cd
VITE_API_ROOT_URL=

# development | staging | production
VITE_APP_ENV=development

VITE_DEFAULT_LOCALE=fr

# true : l'API est simulée dans le navigateur par MSW (développement sans backend).
# Rôle simulé : ajouter ?mockRole=client|prestataire|administrateur|aucun à l'URL.
VITE_ENABLE_MOCKS=false
